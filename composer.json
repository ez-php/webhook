{
    "name": "ez-php/webhook",
    "version": "2.5.1",
    "description": "Outgoing webhooks for the ez-php framework — HMAC-signed delivery as a retrying queue job, plus middleware to verify incoming webhook signatures",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Uretschnig",
            "email": "andreas.uretschnig@gmail.com"
        }
    ],
    "keywords": [
        "webhook",
        "hmac",
        "queue",
        "php",
        "framework",
        "ez-php"
    ],
    "homepage": "https://github.com/ez-php/webhook",
    "support": {
        "issues": "https://github.com/ez-php/webhook/issues",
        "source": "https://github.com/ez-php/webhook"
    },
    "require": {
        "php": "^8.5",
        "ez-php/contracts": "^2.0",
        "ez-php/http": "^2.0",
        "ez-php/http-client": "^2.0",
        "ez-php/queue": "^2.0"
    },
    "require-dev": {
        "ez-php/docker": "^2.0",
        "ez-php/testing-application": "^2.0",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EzPhp\\Webhook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "full": "composer analyse && composer cs && composer test"
    }
}
